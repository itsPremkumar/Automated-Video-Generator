# =============================================================================
# Voicebox Backend — Production Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your deployment.
#
#   cp .env.example .env
#   docker compose --env-file .env up -d speech
# =============================================================================

# ── Data & Model Storage ─────────────────────────────────────────────────
# Persistent storage for voice profiles, generated audio, and model cache.
# Map this to a Docker volume or host directory.
VOICEBOX_DATA_DIR=/data
VOICEBOX_MODELS_DIR=/data/models/hub

# ── Server Settings ──────────────────────────────────────────────────────
# Number of uvicorn workers (1 is recommended for GPU inference).
VOICEBOX_WORKERS=1
# Log level: debug | info | warning | error
VOICEBOX_LOG_LEVEL=info

# ── Model Preloading ─────────────────────────────────────────────────────
# Comma-separated list of models to preload at startup.
# Examples:
#   VOICEBOX_PRELOAD=kokoro
#   VOICEBOX_PRELOAD=kokoro,qwen-tts-1.7B
VOICEBOX_PRELOAD=kokoro

# ── GPU Support ──────────────────────────────────────────────────────────
# Uncomment for NVIDIA CUDA GPU:
# NVIDIA_VISIBLE_DEVICES=all
# NVIDIA_DRIVER_CAPABILITIES=compute,utility

# ── PyTorch Settings ─────────────────────────────────────────────────────
# OMP_NUM_THREADS controls CPU parallelism for PyTorch ops.
# Set to the number of CPU cores available to the container.
# OMP_NUM_THREADS=4

# ── Voice Profiles (for downstream pipeline integration) ─────────────────
# Create a Kokoro preset profile via:
#   curl -X POST http://localhost:17493/profiles \
#     -H 'Content-Type: application/json' \
#     -d '{"name":"Narrator","voice_type":"preset","preset_engine":"kokoro","preset_voice_id":"af_heart"}'
# Then set the returned ID here:
# VOICEBOX_PROFILE_ID=your-profile-uuid
